# Dependencies and build output.
node_modules/
dist/
coverage/
test-results/
playwright-report/

# Exported int8 ONNX model folders, hundreds of MB each and produced outside
# this package. They are never bundled: the extension downloads the model
# from the URL in model.source.json, which a developer serves locally. Only
# each package's manifests (model.json and every adapter.json, a few KB) are
# kept in git.
models/*/*
!models/*/model.json
!models/*/adapters/
models/*/adapters/*/*
!models/*/adapters/*/adapter.json

*.tsbuildinfo

# Custom onnxruntime-web build (with LoRA adapter support) and the matching
# onnxruntime-common, installed from here by package.json. Large binaries:
# kept on the developer's machine, not in git.
vendor/
*.tgz
