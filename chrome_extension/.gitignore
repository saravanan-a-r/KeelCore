# Dependencies and build output.
node_modules/
dist/
coverage/
test-results/
playwright-report/

# Local copies of model files, hundreds of MB each. They are never bundled or
# committed: the extension downloads the model from Hugging Face, from the
# URL in model.source.json.
models/

*.tsbuildinfo

# The old custom onnxruntime-web build, from before onnxruntime-web 1.31.1 (which
# has LoRA adapter support) was on npm. Nothing uses it any more; large binaries
# that stay out of git.
vendor/
*.tgz

# The Chrome Web Store zip, rebuilt by every production build.
release/
