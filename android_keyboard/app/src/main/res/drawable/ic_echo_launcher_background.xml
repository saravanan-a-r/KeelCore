    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="108"
                android:endY="108"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="@color/echo_500" android:offset="0" />
                <item android:color="@color/iris_500" android:offset="0.55" />
                <item android:color="@color/better_400" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
